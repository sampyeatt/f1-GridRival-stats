    "cors": "^2.8.5",
    "dotenv": "^17.2.1",
    "express": "^5.1.0",
    "express-rate-limit": "^8.7.0",
    "jsonwebtoken": "^9.0.2",
    "lodash": "^4.17.21",
    "node-cron": "^4.6.0",
    "pg": "^8.16.3",
    "reflect-metadata": "^0.2.2",
    "resend": "^4.8.0",
    "sequelize": "^6.37.7",
    "sequelize-typescript": "^2.1.6",
