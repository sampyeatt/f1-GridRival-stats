    "@types/node": "^24.2.0",
    "@types/node-cron": "^3.0.11",
    "@types/validator": "^13.15.2",
    "@vitest/coverage-v8": "^4.1.11",
    "nodemon": "^3.1.10",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.2",
    "unplugin-swc": "^1.5.11",
    "vitest": "^4.1.11"
