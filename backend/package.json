  "main": "index.js",
  "scripts": {
    "build": "npx tsc",
    "start": "node dist/scripts/migrate.js && node dist/index.js",
    "dev": "nodemon src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "fixtures:refresh": "node test/refresh-fixtures.mjs",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "migrate": "ts-node src/scripts/migrate.ts",
    "backfill": "ts-node src/scripts/backfill.ts",
    "grant-admin": "ts-node src/scripts/grant-admin.ts",
    "migrate:built": "node dist/scripts/migrate.js"
  },
  "keywords": [],
  "author": "",
