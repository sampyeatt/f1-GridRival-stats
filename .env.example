# Copy to `.env` (same directory as docker-compose.yaml) and fill in.
# `.env` is gitignored; this example file is not.

# --- Required ---------------------------------------------------------------

# Postgres password, used by both the db container and the backend.
POSTGRES_PASSWORD=

# Signs auth tokens. Generate one with: openssl rand -base64 48
JWT_SECRET=

# Resend API key for confirmation and password-reset emails.
RESEND_API_KEY=

# --- Optional (defaults shown) ----------------------------------------------

# POSTGRES_USER=f1-data-user
# POSTGRES_DB=postgres
# POSTGRES_PORT=5435

# Host port nginx is published on.
# HTTP_PORT=8080

# SCHEDULER_ENABLED=true
# SCHEDULER_TICK_CRON="*/15 * * * *"
# SCHEDULER_SYNC_CRON="0 3 * * 1"

# Comma-separated allowlist. Off by default — everything is same-origin.
# CORS_ORIGINS=

# JOLPICA_BASE_URL=https://api.jolpi.ca/ergast/f1
# JOLPICA_USER_AGENT=F1GridRivalStats/0.3.0
